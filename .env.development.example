# Salin ke .env untuk development. Semua password di bawah hanya contoh.
POSTGRES_DB=akgtk
POSTGRES_USER=akgtk
POSTGRES_PASSWORD=dev-only-change-me-2026
# Port host database development (default 5433) agar tidak bentrok dengan
# PostgreSQL production di 5432.
DEV_DB_PORT=5433
DATABASE_URL=postgresql://akgtk:dev-only-change-me-2026@localhost:5433/akgtk?schema=public
AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_URL=http://localhost:3000
# Opsional: hostname/IP tambahan bila alamat development tidak otomatis terdeteksi.
DEV_ALLOWED_ORIGINS=
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ruang AKGTK <noreply@example.com>

DONATION_URL=
DONATION_MESSAGE=Jika aplikasi ini bermanfaat, dukung pengembangannya melalui donasi.
