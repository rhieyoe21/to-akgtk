# Salin menjadi .env pada server. Jangan commit file .env.
POSTGRES_DB=akgtk
POSTGRES_USER=akgtk
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql://akgtk:change-this-db-password@db:5432/akgtk?schema=public
AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_URL=https://tryout.example.com
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Google AI Studio - hanya dipakai server, jangan gunakan awalan NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# SMTP untuk reset password (opsional saat development; wajib di produksi).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ruang AKGTK <noreply@example.com>

# Tunnel Cloudflare. Opsional untuk menjalankan aplikasi lokal tanpa tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Pesan donasi yang tampil setelah tryout (opsional).
DONATION_URL=
DONATION_MESSAGE=Jika aplikasi ini bermanfaat, dukung pengembangannya melalui donasi.
